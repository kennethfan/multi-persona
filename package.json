{
  "name": "multi-persona",
  "version": "0.1.0",
  "description": "多账号会话隔离桌面应用（T1：应用骨架）",
  "main": "dist/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "npm run build && electron .",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --mac dmg",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.0.0",
    "typescript": "^7.0.0",
    "vitest": "^5.0.0"
  },
  "build": {
    "appId": "com.kennethfan.multi-persona",
    "productName": "千岛",
    "files": [
      "dist/**/*",
      "renderer/**/*",
      "build/icon.icns",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico"
    }
  }
}
